      "to": {
        "food": "lf-yogurt-plain",
        "display": "lactose-free plain yogurt",
        "grams_per_gram": 1,
        "amount_text": "same amount"
      },
      "how": "Use lactose-free yogurt in the same amount.",
      "sources": [
        "nih-lactose-consensus-2010",
        "halmos-2014"
      ]
    },
    {
      "id": "cream-to-lactose-free",
      "family": "low-fodmap",
      "match": "\\b(double|single|heavy|light|whipping|pouring)?\\s*cream\\b|\\bhalf[- ]and[- ]half\\b",
      "except": "(lactose-free|lactose free|coconut|cream cheese|ice cream|sour cream|creamed|cream of|creamy)",
      "to": {
        "food": "lf-cream-light",
        "display": "lactose-free cream",
        "grams_per_gram": 1,
        "amount_text": "same amount"
      },
      "how": "Use lactose-free cream in the same amount.",
      "sources": [
        "nih-lactose-consensus-2010"
      ]
    },
    {
      "id": "honey-to-maple",
      "family": "low-fodmap",
      "match": "\\b(honey|agave|agave nectar|agave syrup|high-fructose corn syrup|high fructose corn syrup)\\b",
      "to": {
        "food": "fdc-169661",
        "display": "pure maple syrup",
        "grams_per_gram": 1,
        "amount_text": "same amount"
      },
      "how": "Use pure maple syrup in the same amount. Honey and agave carry excess fructose; maple syrup is balanced sugar.",
      "sources": [
        "varney-2017"
      ]
    },
    {
      "id": "cauliflower-to-broccoli",
      "family": "low-fodmap",
      "match": "\\bcauliflower\\b",
      "to": {
        "food": "fdc-747447",
        "display": "broccoli florets",
        "grams_per_gram": 1,
        "amount_text": "same amount"
      },
      "how": "Use broccoli florets in the same amount and cook them the same way. Cauliflower carries mannitol; broccoli heads are low FODMAP at a normal serve.",
      "sources": [
        "varney-2017"
      ]
    },
    {
      "id": "mushrooms-to-oyster",
      "family": "low-fodmap",
      "match": "\\b(button|white|chestnut|cremini|crimini|portobello|portabella|shiitake|field|mixed)?\\s*mushrooms?\\b",
      "except": "oyster",
      "to": {
        "food": "fdc-168580",
        "display": "oyster mushrooms",
        "grams_per_gram": 1,
        "amount_text": "same amount"
      },
      "how": "Use oyster mushrooms in the same amount. Button and most other mushrooms carry mannitol; oyster mushrooms are low FODMAP in the Monash-group data.",
      "sources": [
        "varney-2017"
      ]
    },
    {
      "id": "cashews-to-macadamia",
      "family": "low-fodmap",
      "match": "\\b(cashews?|pistachios?)\\b",
      "to": {
        "food": "fdc-2515378",
        "display": "macadamia nuts",
        "grams_per_gram": 1,
        "amount_text": "same amount"
      },
      "how": "Use macadamia nuts in the same amount. Cashews and pistachios carry galacto-oligosaccharides; macadamias do not.",
      "sources": [
        "varney-2017"
      ]
    },
    {
      "id": "flour-tortilla-to-corn",
      "family": "low-fodmap",
      "match": "\\b(flour|wheat)\\s+tortillas?\\b|\\btortillas?\\b",
      "except": "(corn|maize)",
      "to": {
        "food": "fdc-173241",
        "display": "corn tortillas",
        "grams_per_gram": 1,
        "amount_text": "same number"
      },
      "how": "Use corn tortillas, the same number. Wheat tortillas carry fructans.",
      "sources": [
        "varney-2017"
      ]
    },
    {
      "id": "tomato-paste-to-pumpkin",
      "family": "low-histamine",
      "match": "\\btomato\\s+(paste|pur[eé]e|concentrate)\\b|\\bpassata\\b|\\bketchup\\b|\\btomato\\s+ketchup\\b",
      "to": {
        "food": "fdc-168450",
        "display": "pumpkin purée",
        "grams_per_gram": 1,
        "amount_text": "same amount"
      },
      "how": "Use pumpkin purée in the same amount for body and colour, with a pinch of paprika if you want warmth. Tomato is a commonly reported histamine trigger; pumpkin is on the well-tolerated side of the SIGHI list.",
      "sources": [
        "sighi-list"
      ]
    },
    {
      "id": "tomato-to-red-pepper",
      "family": "low-histamine",
      "match": "\\btomato(es)?\\b",
      "to": {
        "food": "fdc-170110",
        "display": "fresh-roasted red bell pepper",
        "grams_per_gram": 1,
        "amount_text": "same amount"
      },
      "how": "Roast red bell peppers yourself (under the grill or in a hot oven until the skins char, then peel) and use them in the same amount, chopped or blended where the tomato went. Not jarred roasted peppers: they are packed in vinegar or brine, which the SIGHI leaflet lists under To avoid. Tomato is a commonly reported histamine trigger; fresh sweet red pepper is well tolerated on the SIGHI list.",
      "sources": [
        "sighi-list",
        "sighi-leaflet-2021"
      ]
    },
    {
      "id": "spinach-to-kale",
      "family": "low-histamine",
      "match": "\\bspinach\\b",
      "to": {
        "food": "fdc-323505",
        "display": "young kale or chard leaves",
        "grams_per_gram": 1,
        "amount_text": "same amount"
      },
      "how": "Use young kale or chard leaves in the same amount, cooked a minute or two longer. Spinach is on the SIGHI list as a histamine-rich vegetable.",
      "sources": [
        "sighi-list"
      ]
    },
    {
      "id": "eggplant-to-zucchini",
      "family": "low-histamine",
      "match": "\\b(eggplant|aubergine)s?\\b",
      "to": {
        "food": "fdc-169291",
        "display": "zucchini",
        "grams_per_gram": 1,
        "amount_text": "same amount"
      },
      "how": "Use zucchini in the same amount; it cooks faster, so add it a few minutes later. Eggplant is on the SIGHI list as histamine-rich.",
      "sources": [
        "sighi-list"
      ]
    },
    {
      "id": "aged-cheese-to-mozzarella",
      "family": "low-histamine",
      "match": "\\b(parmesan|parmigiano|pecorino|cheddar|gouda|gruy[eè]re|emmental|swiss cheese|edam|manchego|blue cheese|stilton|gorgonzola|roquefort|brie|camembert|aged cheese|mature cheese|hard cheese)\\b|\\bcheese\\b",
      "except": "(mozzarella|ricotta|cream cheese|cottage|mascarpone|paneer|halloumi|goat|quark|fresh cheese)",
      "to": {
        "food": "fdc-170845",
        "display": "fresh mozzarella",
        "grams_per_gram": 1,
        "amount_text": "same amount"
      },
      "how": "Use fresh mozzarella in the same amount. Histamine builds as cheese ages; young, fresh cheeses are the low end of the SIGHI list.",
      "sources": [
        "sighi-list",
        "comas-baste-2020"
      ]
    },
    {
      "id": "cured-meat-to-chicken",
      "family": "low-histamine",
      "match": "\\b(bacon|ham|salami|chorizo|pepperoni|prosciutto|pancetta|speck|bresaola|pastrami|smoked (chicken|turkey|meat|ham)|cured meat|deli meat|luncheon meat)\\b",
      "to": {
        "food": "fdc-171052",
        "display": "fresh chicken, diced",
        "grams_per_gram": 1,
        "amount_text": "same amount"
      },
      "how": "Use fresh chicken in the same amount, seasoned with paprika and a little salt for the smoky note. Cured, smoked, and aged meats are the highest-histamine meats on the SIGHI list; fresh meat is the lowest.",
      "sources": [
        "sighi-list",
        "comas-baste-2020"
      ]
    },
    {
      "id": "preserved-fish-to-cod",
      "family": "low-histamine",
      "match": "\\b(tuna|sardines?|anchov(y|ies)|mackerel|herring|smoked salmon|smoked fish|smoked haddock|kippers?|shrimp|prawns?|crab|lobster|mussels?|clams?|scallops?|squid|calamari|shellfish)\\b",
      "to": {
        "food": "fdc-174191",
        "display": "fresh or frozen cod",
        "grams_per_gram": 1,
        "amount_text": "same amount"
      },
      "how": "Use fresh or quickly frozen white fish such as cod in the same amount. Canned, smoked, and scombroid fish and shellfish are the highest-histamine foods on the SIGHI list; fresh white fish is among the lowest.",
      "sources": [
        "sighi-list",
        "comas-baste-2020"
      ]
    },
    {
      "id": "strawberries-to-blueberries",
      "family": "low-histamine",
      "match": "\\bstrawberr(y|ies)\\b",
      "to": {
        "food": "fdc-2346411",
        "display": "blueberries",
        "grams_per_gram": 1,
        "amount_text": "same amount"
      },
      "how": "Use blueberries in the same amount. Strawberries are a listed histamine liberator; blueberries are well tolerated on the SIGHI list.",
      "sources": [
        "sighi-list"
      ]
    },
    {
      "id": "nuts-to-macadamia",
      "family": "low-histamine",
      "match": "\\b(walnuts?|cashews?|peanuts?)\\b",
      "except": "butter",
      "to": {
        "food": "fdc-2515378",
        "display": "macadamia nuts",
        "grams_per_gram": 1,
        "amount_text": "same amount"
      },
      "how": "Use macadamia nuts in the same amount. Walnuts, cashews, and peanuts are listed histamine triggers; macadamias are well tolerated.",
      "sources": [
        "sighi-list"
      ]
    },
    {
      "id": "vinegar-out",
      "family": "low-histamine",
      "match": "\\bvinegar\\b|\\bpickled\\b|\\bpickles?\\b|\\bsauerkraut\\b|\\bkimchi\\b",
      "to": null,
      "how": "Leave it out. Wine, balsamic, rice, and malt vinegar and pickled or fermented vegetables are fermented foods. For brightness, use a splash of distilled white vinegar or apple cider vinegar (both well tolerated in the SIGHI leaflet), apple juice, or a pinch of sugar and salt instead.",
      "sources": [
        "sighi-list",
        "sighi-leaflet-2021"
      ],
      "except": "\\b(distilled( white)?|white|spirit|apple cider|cider)[\\s-]+vinegar\\b"
    },
    {
      "id": "soy-sauce-out",
      "family": "low-histamine",
      "match": "\\b(soy sauce|soya sauce|tamari|shoyu|fish sauce|oyster sauce|worcestershire|miso|hoisin)\\b",
      "to": null,
      "how": "Leave it out and season with salt, a little ground ginger, and fresh herbs. These are fermented sauces, the top of the histamine list.",
      "sources": [
        "sighi-list"
      ]
    },
    {
      "id": "wine-to-stock",
      "family": "low-histamine",
      "match": "\\b(red wine|white wine|wine|beer|lager|cider|sherry|port|brandy|rum|vermouth)\\b",
      "except": "vinegar",
      "to": {
        "food": "fdc-173647",
        "display": "water or quick homemade vegetable stock",
        "grams_per_gram": 1,
        "amount_text": "same amount"
      },
      "how": "Use water, or a vegetable stock you simmered under 30 minutes, in the same amount. Wine and beer are fermented and carry histamine; cooking does not remove it.",
      "sources": [
        "sighi-list",
        "comas-baste-2020"
      ]
    }
  ]
}
