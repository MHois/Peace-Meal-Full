{
  "version": 1,
  "notes": [
    "Substitutions the planner may apply to a recipe that is blocked only by ingredients on this list, producing an adapted copy for one diet family.",
    "Every swap cites its source. A swap either replaces the ingredient (to.food, to.display) or removes it (to: null) with instructions in how.",
    "Adapted copies of recipes whose ingredients are linked to USDA foods get exact nutrition recomputed from the new ingredients. Adapted copies of recipes that only carry published per-serving numbers keep those numbers and are marked approximate.",
    "match is a regular expression tested against the ingredient text (lower-case); except stops a swap when the text already names the safe form."
  ],
  "families": {
    "low-fodmap": {
      "label": "low FODMAP",
      "tags": [
        "fodmap-fructan",
        "fodmap-gos",
        "fodmap-lactose",
        "fodmap-fructose",
        "fodmap-sorbitol",
        "fodmap-mannitol"
      ],
      "sources": [
        "monash-fodmap",
        "varney-2017",
        "halmos-2014"
      ],
      "module": "ibs-low-fodmap"
    },
    "low-histamine": {
      "label": "low histamine",
      "tags": [
        "histamine-high",
        "histamine-aged",
        "histamine-fermented"
      ],
      "sources": [
        "sighi-list",
        "comas-baste-2020"
      ],
      "module": "mcas"
    }
  },
  "swaps": [
    {
      "id": "garlic-to-infused-oil",
      "family": "low-fodmap",
      "match": "\\bgarlic\\b",
      "except": "infused",
      "to": {
        "food": "fdc-171413",
        "display": "garlic-infused olive oil",
        "grams_per_gram": 2,
        "grams_min": 10,
        "amount_text": "1 to 2 teaspoons per clove"
      },
      "how": "Use garlic-infused olive oil instead of garlic. Fructans do not dissolve in oil, so the flavour comes through without the FODMAP load; strain out any garlic pieces and add the oil where the garlic went.",
      "sources": [
        "varney-2017"
      ]
    },
    {
      "id": "onion-to-chives",
      "family": "low-fodmap",
      "match": "\\b(onions?|shallots?|leeks?)\\b",
      "except": "(green tops|greens|chives|tops of|green part)",
      "to": {
        "food": "fdc-169994",
        "display": "chives or spring onion green tops",
        "grams_per_gram": 0.4,
        "grams_min": 10,
        "amount_text": "a small handful per onion"
      },
      "how": "Swap onion, shallot, or leek for chives or the green tops of spring onions, added near the end. The green leaves are low FODMAP; the white bulb carries the fructans.",
      "sources": [
        "varney-2017",
        "halmos-2014"
      ]
    },
    {
      "id": "wheat-pasta-to-gf",
      "family": "low-fodmap",
      "match": "\\b(pasta|spaghetti|penne|fusilli|macaroni|linguine|fettuccine|tagliatelle|rigatoni|farfalle|orzo|lasagne|lasagna sheets|noodles?)\\b",
      "except": "(gluten-free|gluten free|rice noodle|corn|buckwheat|soba)",
      "to": {
        "food": "fdc-168899",
        "display": "gluten-free corn and rice pasta",
        "grams_per_gram": 1,
        "amount_text": "same amount"
      },
      "how": "Use a gluten-free corn and rice pasta in the same amount. Wheat pasta carries fructans; the corn and rice kind does not. Cook it a minute less than the packet says so it holds its shape.",
      "sources": [
        "varney-2017"
      ]
    },
    {
      "id": "wheat-flour-to-rice-flour",
      "family": "low-fodmap",
      "match": "\\b(plain|all-purpose|all purpose|self-raising|self raising|wholemeal|whole wheat|whole-wheat|bread|wheat|white)?\\s*flour\\b",
      "except": "(rice|corn|maize|almond|coconut|buckwheat|gluten-free|gluten free|chickpea|gram|oat|potato|tapioca|quinoa|sorghum|millet|teff)",
      "to": {
        "food": "fdc-790214",
        "display": "white rice flour",
        "grams_per_gram": 1,
        "amount_text": "same amount"
      },
      "how": "Use white rice flour one for one to thicken sauces, coat, or dust. For baking, use a gluten-free flour blend instead and expect a slightly different texture.",
      "sources": [
        "varney-2017"
      ]
    },
    {
      "id": "couscous-to-quinoa",
      "family": "low-fodmap",
      "match": "\\b(couscous|bulgur|bulghur|pearl barley|barley|freekeh|spelt)\\b",
      "to": {
        "food": "fdc-168874",
        "display": "quinoa",
        "grams_per_gram": 1,
        "amount_text": "same amount"
      },
      "how": "Use quinoa in the same amount and cook it the same way. Couscous, bulgur, and barley are wheat or barley and carry fructans; quinoa does not.",
      "sources": [
        "varney-2017"
      ]
    },
    {
      "id": "milk-to-lactose-free-lowfat",
      "family": "low-fodmap",
      "match": "\\b(skimmed|skim|semi-skimmed|semi skimmed|1%|2%|low-fat|lowfat|low fat|reduced-fat|reduced fat)\\b[^,;]*\\bmilk\\b|\\bmilk\\b[^,;]*\\b(skimmed|skim|semi-skimmed|1%|2%|low-fat|low fat)\\b",
      "except": "(lactose-free|lactose free|coconut|almond|oat|rice|soy|soya|hemp|cashew|goat|sheep|sweetened condensed|evaporated|powder|buttermilk)",
      "to": {
        "food": "lf-milk-lowfat",
        "display": "lactose-free low-fat milk",
        "grams_per_gram": 1,
        "amount_text": "same amount"
      },
      "how": "Use lactose-free milk in the same amount. The lactose is already split, so the taste and nutrients are the same and the FODMAP load is gone.",
      "sources": [
        "nih-lactose-consensus-2010",
        "halmos-2014"
      ]
    },
    {
      "id": "milk-to-lactose-free",
      "family": "low-fodmap",
      "match": "\\bmilk\\b",
      "except": "(lactose-free|lactose free|coconut|almond|oat|rice|soy|soya|hemp|cashew|goat|sheep|sweetened condensed|evaporated|powder|buttermilk|chocolate)",
      "to": {
        "food": "lf-milk-whole",
        "display": "lactose-free whole milk",
        "grams_per_gram": 1,
        "amount_text": "same amount"
      },
      "how": "Use lactose-free milk in the same amount. The lactose is already split, so the taste and nutrients are the same and the FODMAP load is gone.",
      "sources": [
        "nih-lactose-consensus-2010",
        "halmos-2014"
      ]
    },
    {
